      "body": { "$value": 13, "$description": "Texte courant (taille macOS standard)." },
      "bodySmall": { "$value": 12, "$description": "Sous-titres, aides, textes secondaires." },
      "caption": { "$value": 11.5, "$description": "En-têtes de groupe, légendes." },
      "micro": { "$value": 11, "$description": "Étiquettes de statut." }
    }
  },
  "size": {
    "control": { "$value": 32, "$description": "Hauteur des boutons." },
    "badge": { "$value": 30, "$description": "Pastille d'icône des lignes de liste." },
    "icon": { "$value": 18, "$description": "Icônes de bouton et de navigation." },
