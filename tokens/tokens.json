{
  "$description": "Valeurs de design communes à toutes les applis. Source unique : chaque techno (flutter/, web/…) les génère depuis ce fichier. Couleurs en #RRGGBB ou #AARRGGBB, tailles en points logiques, opacités entre 0 et 1.",
  "color": {
    "accent": {
      "light": { "$value": "#007AFF", "$description": "Bleu système Apple, thème clair (boutons, liens, sélection)." },
      "dark": { "$value": "#0A84FF", "$description": "Bleu système Apple, thème sombre." }
    },
    "background": {
      "light": {
        "top": { "$value": "#F2F3F6", "$description": "Fond d'appli, haut du dégradé (clair)." },
        "bottom": { "$value": "#E6E8EC", "$description": "Fond d'appli, bas du dégradé (clair)." }
      },
      "dark": {
        "top": { "$value": "#15171C", "$description": "Fond d'appli, haut du dégradé (sombre)." },
        "bottom": { "$value": "#0D0E12", "$description": "Fond d'appli, bas du dégradé (sombre)." }
      }
    },
    "status": {
      "success": { "$value": "#22A06B", "$description": "Succès, état positif (« Envoyée », « En cours »)." },
      "warning": { "$value": "#E8A33D", "$description": "À faire, attention (« À générer », rappels)." }
    },
    "badge": {
      "start": { "$value": "#3D8BFF", "$description": "Dégradé des pastilles d'icône, début." },
      "end": { "$value": "#7B5CFF", "$description": "Dégradé des pastilles d'icône, fin." }
    },
    "tooltip": {
      "light": { "$value": "#EE30323D", "$description": "Fond des bulles d'aide (clair), texte blanc." },
      "dark": { "$value": "#F2494C57", "$description": "Fond des bulles d'aide (sombre), texte blanc." }
    }
  },
  "opacity": {
    "glass": {
      "fill": {
        "light": { "$value": 0.52, "$description": "Remplissage blanc du verre (clair)." },
        "dark": { "$value": 0.07, "$description": "Remplissage blanc du verre (sombre)." }
      },
      "fillStrong": {
        "light": { "$value": 0.78, "$description": "Verre au premier plan : dialogues (clair)." },
        "dark": { "$value": 0.13, "$description": "Verre au premier plan : dialogues (sombre)." }
      },
      "tint": {
        "light": { "$value": 0.18, "$description": "Verre teinté d'une couleur (clair)." },
        "dark": { "$value": 0.22, "$description": "Verre teinté d'une couleur (sombre)." }
      },
      "border": {
        "light": { "$value": 0.75, "$description": "Bordure lumineuse blanche du verre (clair)." },
        "dark": { "$value": 0.13, "$description": "Bordure lumineuse blanche du verre (sombre)." }
      },
      "sheen": {
        "light": { "$value": 0.12, "$description": "Reflet blanc en haut du verre (clair) : discret." },
        "dark": { "$value": 0.03, "$description": "Reflet blanc en haut du verre (sombre)." }
      }
    },
    "background": {
      "translucent": {
        "light": { "$value": 0.68, "$description": "Opacité du fond quand la fenêtre native est floutée (macOS, clair)." },
        "dark": { "$value": 0.72, "$description": "Idem en sombre." }
      }
    }
  },
  "blur": {
    "glass": { "$value": 24, "$description": "Flou d'arrière-plan du verre (sigma)." }
  },
  "radius": {
    "control": { "$value": 10, "$description": "Champs de saisie, menus, éléments de liste." },
    "badge": { "$value": 8, "$description": "Pastilles d'icône." },
    "group": { "$value": 14, "$description": "Panneaux de liste groupée." },
    "section": { "$value": 16, "$description": "Sections de page (réglages)." },
    "sidebar": { "$value": 18, "$description": "Barre latérale flottante." },
    "dialog": { "$value": 20, "$description": "Dialogues." }
  },
  "font": {
    "size": {
      "headline": { "$value": 22, "$description": "Grand titre (rare)." },
      "title": { "$value": 17, "$description": "Titre de page, dans la barre d'outils." },
