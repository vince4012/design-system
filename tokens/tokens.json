    "toolbar": { "$value": 52, "$description": "Hauteur de la barre d'outils native macOS (unifiée)." },
    "pageToolbar": { "$value": 40, "$description": "Hauteur de la barre de titre d'une page." }
  },
  "space": {
    "xs": { "$value": 4 },
    "s": { "$value": 8 },
    "m": { "$value": 12 },
    "l": { "$value": 16 },
    "xl": { "$value": 20 }
  }
